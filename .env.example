# ===========================================================================
#  ICLABS — Template Konfigurasi Environment
#  ICo Labs Monitoring System | FIKOM Universitas Muslim Indonesia
# ===========================================================================
#
#  CARA PENGGUNAAN
#  ───────────────
#  1. Salin file ini:
#       cp .env.example .env
#  2. Sesuaikan setiap nilai di bawah dengan environment Anda.
#  3. File ".env" TIDAK BOLEH di-commit ke Git (sudah terdaftar di .gitignore).
#  4. Jangan pernah membagikan file ".env" yang sudah berisi secret asli.
#
#  GENERATE SECRET (terminal)
#  ──────────────────────────
#  JWT_SECRET   : php -r "echo bin2hex(random_bytes(32));"
#  HASH_SALT     : php -r "echo bin2hex(random_bytes(16));"
#
# ===========================================================================


# ---------------------------------------------------------------------------
# APLIKASI
# ---------------------------------------------------------------------------

# Lingkungan: "local" atau "production"
#   local      → error PHP tampil langsung (untuk development)
#   production → error disembunyikan dari user, dikirim ke storage/logs/
APP_ENV=local

# Mode debug: true (dev) | false (wajib di produksi)
APP_DEBUG=true

# Base URL aplikasi.
# Kosongkan ("") agar terdeteksi otomatis dari domain & subfolder project.
# Isi manual hanya jika auto-detect tidak sesuai:
#   XAMPP Windows  : http://localhost/ICLABS/public
#   XAMPP macOS    : http://localhost/ICLABS/public
#   Produksi       : https://domain-anda.com
BASE_URL=http://localhost/ICLABS/public


# ---------------------------------------------------------------------------
# DATABASE (MySQL / MariaDB)
# ---------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_NAME=iclabs_db
DB_USER=root
DB_PASS=
# Charset wajib utf8mb4 agar mendukung emoji & karakter Unicode penuh
DB_CHARSET=utf8mb4


# ---------------------------------------------------------------------------
# JWT — Token Autentikasi REST API (dikonsumsi aplikasi mobile)
# ---------------------------------------------------------------------------

# ⚠️  WAJIB diganti sebelum deploy ke produksi!
#     Gunakan string acak ≥ 64 karakter.
#     Generate: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_64_KARAKTER

# Masa berlaku access token (detik). Default: 86400 = 24 jam.
JWT_EXPIRATION=86400

# Masa berlaku refresh token (detik). Default: 604800 = 7 hari.
JWT_REFRESH_EXPIRATION=604800


# ---------------------------------------------------------------------------
# KEAMANAN — Hash & Enkripsi
# ---------------------------------------------------------------------------

# Salt untuk obfuskasi ID di URL (HashHelper::encode/decode).
# ⚠️  WAJIB diganti sebelum deploy ke produksi!
#     Generate: php -r "echo bin2hex(random_bytes(16));"
HASH_SALT=GANTI_DENGAN_STRING_ACAK_UNIK


# ---------------------------------------------------------------------------
# GOOGLE CALENDAR INTEGRATION
# (Opsional — hanya diperlukan jika fitur sinkronisasi kalender diaktifkan)
# ---------------------------------------------------------------------------
#
# Langkah aktivasi:
#   1. Buka https://console.cloud.google.com/apis/credentials
#   2. Buat OAuth 2.0 Client ID (tipe: Web application)
#   3. Tambahkan Authorized Redirect URI:
#        {BASE_URL}/google/callback
#        Contoh: http://localhost/ICLABS/public/google/callback
#   4. Aktifkan "Google Calendar API" pada project Google Cloud Anda
#   5. Isi Client ID & Secret di bawah ini
#
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kosongkan agar otomatis menggunakan {BASE_URL}/google/callback
GOOGLE_REDIRECT_URI=


# ---------------------------------------------------------------------------
# EMAIL / SMTP (Opsional — untuk notifikasi email)
# ---------------------------------------------------------------------------
# Aktifkan jika ingin mengirim notifikasi via email (mis. reset password)

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@domain-anda.com
MAIL_FROM_NAME=ICLABS System


# ---------------------------------------------------------------------------
# TIMEZONE
# ---------------------------------------------------------------------------

# Timezone server. WITA = Asia/Makassar (UTC+8)
APP_TIMEZONE=Asia/Makassar
