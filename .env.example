# =====================================================================
#  ICLABS - Contoh Konfigurasi Environment
# =====================================================================
#  1. Salin file ini menjadi ".env" (di folder yang sama / root project)
#  2. Sesuaikan nilai di bawah dengan environment lokal/produksi Anda
#  3. File ".env" TIDAK akan ter-commit ke Git (sudah ada di .gitignore)
# =====================================================================

# ---------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------
# local      -> menampilkan error PHP secara langsung (untuk development)
# production -> menyembunyikan error dari user, mengirim ke log server
APP_ENV=local
APP_DEBUG=true

# Kosongkan agar BASE_URL terdeteksi otomatis dari domain & folder project.
# Isi manual hanya jika auto-detect tidak sesuai, contoh:
#   Windows (XAMPP)  : http://localhost/ICLABS/public
#   macOS (XAMPP/MAMP): http://localhost/ICLABS/public
#   Produksi         : https://domainanda.com
BASE_URL=http://localhost/ICLABS/public

# ---------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=iclabs_db

# ---------------------------------------------------------------
# JWT (untuk REST API yang dikonsumsi aplikasi mobile)
# ---------------------------------------------------------------
# WAJIB diganti dengan string acak & panjang sebelum deploy ke produksi!
# Generate via terminal:  php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=kunci_rahasia_kamu_123

# Masa berlaku token dalam detik. 86400 = 24 jam (sesuai dokumentasi API).
JWT_EXPIRATION=86400

# ---------------------------------------------------------------
# GOOGLE CALENDAR INTEGRATION (opsional, untuk sinkronisasi jadwal)
# ---------------------------------------------------------------
# 1. Buat OAuth Client ID (Web application) di:
#    https://console.cloud.google.com/apis/credentials
# 2. Tambahkan Authorized redirect URI:
#    {BASE_URL}/google/callback
#    contoh: http://localhost/ICLABS/public/google/callback
# 3. Aktifkan "Google Calendar API" pada project Google Cloud Anda
# 4. Isi Client ID & Client Secret di bawah ini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kosongkan agar otomatis memakai {BASE_URL}/google/callback
GOOGLE_REDIRECT_URI=
